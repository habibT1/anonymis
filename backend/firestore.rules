rules_version = '2';

// Tout accès direct depuis un client (navigateur, SDK web/mobile) est refusé.
// Le backend utilise le SDK Admin de Firebase, qui ne passe pas par ces règles.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
