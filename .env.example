# Copier en .env (ignoré par git) puis remplir.
# Charger dans le shell avant de lancer le backend :  set -a; source .env; set +a

# Backend — obligatoire. Générer avec : openssl rand -base64 32
JWT_SECRET_KEY_BASE64=

# Backend — clé AES-256 (base64) pour chiffrer les PDF et la table de correspondance
# Générer avec : openssl rand -base64 32
DOCUMENT_ENCRYPTION_KEY=

# Backend — fournisseur d'IA : gemini (Gemma 4 en ligne) | ollama (Gemma 4 en local)
LLM_PROVIDER=gemini

# Gemma 4 en ligne — clé sur https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemma-4-26b-a4b-it (rapide) | gemma-4-31b-it (plus précis)
GEMINI_MODEL=gemma-4-26b-a4b-it
# minimal (rapide) | high (réfléchit avant de répondre)
GEMINI_THINKING_LEVEL=minimal

# Gemma 4 en local (si LLM_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
# gemma4:e4b (~6 Go, OK avec 16 Go de RAM) · gemma4:12b (~7 Go, meilleur) · gemma4:26b (~16 Go)
OLLAMA_MODEL=gemma4:e4b
OLLAMA_NUM_CTX=32768
# true = Gemma « réfléchit » avant de répondre : meilleur sur les questions difficiles, ~7x plus lent
OLLAMA_THINK=false

# Backend — adresse du service privacy-engine
PRIVACY_ENGINE_URL=http://127.0.0.1:8090

# Backend — origines CORS autorisées
ALLOWED_ORIGINS=http://127.0.0.1:4200,http://localhost:4200
